{
	"schemaVersion": 1,
	"id": "mcme-modpack-marker",
	"version": "${version}",
	"name": "MCME Modpack Marker",
	"description": "Utilities for MC Middle Earth server: tells it which mods are installed, and lets resource packs style Distant Horizons' LODs in all its renderers.",
	"authors": [
		"opl"
	],
	"contact": {
		"homepage": "https://www.mcmiddleearth.com/"
	},
	"license": "UNLICENSED",
	"icon": "assets/mcme-modpack-marker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"im.opl.mcme.marker.MCMEModpackMarker"
		],
		"modmenu": [
			"im.opl.mcme.marker.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		"mcme-modpack-marker.mixins.json"
	],
	"suggests": {
		"distanthorizons": ">=3.3.0",
		"modmenu": "*"
	}
}
